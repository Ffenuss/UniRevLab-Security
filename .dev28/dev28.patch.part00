+    "pressFeedback": true,
+    "resetAll": true,
+    "legacyRuntimeConfigRead": [
+      "v1",
+      "v2"
+    ],
+    "failClosedBinding": true,
+    "gameSpecificProductionRules": false
+  },
+  "requiredActions": [
+    "pytest",
+    "selftest",
+    "runtime-check",
+    "assembleDebug",
+    "lintDebug",
+    "unzip",
+    "zipalign",
+    "apksigner"
+  ]
+}

+bool Il2CppObjectIsClass(void *object, const char *namespaze, const char *clazz) {
+    if (!object || !il2cpp_object_get_class || !il2cpp_class_get_name || !il2cpp_class_get_namespace) return false;
+    void *klass = il2cpp_object_get_class(object);
+    if (!klass) return false;
+    const char *name = il2cpp_class_get_name(klass);
+    const char *ns = il2cpp_class_get_namespace(klass);
+    return name && ns && strcmp(name, clazz) == 0 && strcmp(ns, namespaze) == 0;
+}

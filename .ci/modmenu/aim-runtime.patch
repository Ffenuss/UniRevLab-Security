+static void ApplyDirtyAimWeaponRuntime() {
+    if (dAimSensitivityX || dAimSensitivityY || dAimVerticalClamp || dAimHorizontalClamp) {
+        void *aim = GetLocalAimController();
+        if (aim) {
+            if (dAimSensitivityX)
+                WriteField(aim, NS_AIM, OBFUSCATE("AimController"), OBFUSCATE("sensitivityX"), vAimSensitivityX);
+            if (dAimSensitivityY)
+                WriteField(aim, NS_AIM, OBFUSCATE("AimController"), OBFUSCATE("sensitivityY"), vAimSensitivityY);
+            if (dAimVerticalClamp || dAimHorizontalClamp) {
+                void *params = ReadObjectField(aim, NS_AIM, OBFUSCATE("AimController"), OBFUSCATE("aimingParameters"));
+                if (params) {
+                    if (dAimVerticalClamp)
+                        WriteOffset(params, 0xA0, vAimVerticalClamp); // dump: AimController.AimingParameters.verticalClamp
+                    if (dAimHorizontalClamp)
+                        WriteOffset(params, 0xA4, vAimHorizontalClamp); // dump: AimController.AimingParameters.horizontalClamp
+                }
+            }
+        }
+    }
+
+    if (!(dShowHitMarker || dFireRate || dHitRange || dScopeSensitivity ||
+          dHeadDamage || dChestDamage || dStomachDamage || dLegsDamage ||
+          dRecoilHorizontal || dRecoilVertical)) return;
+
+    void *gun = GetCurrentGunController();
+    if (!gun) return;
+    auto getParams = reinterpret_cast<GetCP>(Method(NS_GUN, OBFUSCATE("GunController"), OBFUSCATE("vxn"), 0));
+    void *params = getParams ? getParams(gun) : nullptr;
+    if (!params) return;
+
+    if (dShowHitMarker)
+        WriteField(params, NS_INVENTORY, OBFUSCATE("WeaponParameters"), OBFUSCATE("_showHitMarker"), vShowHitMarker);
+    if (dFireRate)
+        WriteField(params, NS_GUN, OBFUSCATE("GunParameters"), OBFUSCATE("_fireRate"), vFireRate);
+    if (dHitRange)
+        WriteField(params, NS_GUN, OBFUSCATE("GunParameters"), OBFUSCATE("_hitRange"), vHitRange);
+    if (dScopeSensitivity)
+        WriteField(params, NS_GUN, OBFUSCATE("GunParameters"), OBFUSCATE("_scopeAimSensitivityMult"), vScopeSensitivity);
+
+    if (dHeadDamage || dChestDamage || dStomachDamage || dLegsDamage) {
+        void *damage = ReadObjectField(params, NS_GUN, OBFUSCATE("GunParameters"), OBFUSCATE("_damage"));
+        if (damage) {
+            if (dHeadDamage) WriteField(damage, NS_INVENTORY, OBFUSCATE("Damage"), OBFUSCATE("_headDamage"), vHeadDamage);
+            if (dChestDamage) WriteField(damage, NS_INVENTORY, OBFUSCATE("Damage"), OBFUSCATE("_chestAndArmsDamage"), vChestDamage);
+            if (dStomachDamage) WriteField(damage, NS_INVENTORY, OBFUSCATE("Damage"), OBFUSCATE("_stomachDamage"), vStomachDamage);
+            if (dLegsDamage) WriteField(damage, NS_INVENTORY, OBFUSCATE("Damage"), OBFUSCATE("_legsDamage"), vLegsDamage);
+        }
+    }
+
+    if (dRecoilHorizontal || dRecoilVertical) {
+        void *recoil = ReadObjectField(params, NS_GUN, OBFUSCATE("GunParameters"), OBFUSCATE("_recoilParameters"));
+        if (recoil) {
+            if (dRecoilHorizontal)
+                WriteField(recoil, NS_GUN, OBFUSCATE("RecoilParameters"), OBFUSCATE("horizontalRange"), vRecoilHorizontal);
+            if (dRecoilVertical)
+                WriteField(recoil, NS_GUN, OBFUSCATE("RecoilParameters"), OBFUSCATE("verticalRange"), vRecoilVertical);
+        }
+    }
+}

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<queries>
<intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
</queries>
<application android:name=".App" android:label="@string/app_name" android:icon="@drawable/ic_modkit" android:allowBackup="false" android:theme="@style/Theme.ModKit" android:supportsRtl="true">
<activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
<activity android:name=".ReWorkspaceActivity" android:exported="false"/>
<activity android:name=".DecompilerActivity" android:exported="false"/>
<activity android:name=".FileWorkspaceActivity" android:exported="false"/>
<activity android:name=".SimpleModeActivity" android:exported="false"/>
<activity android:name=".NativeWorkspaceActivity" android:exported="false"/>
<activity android:name=".PatchPackActivity" android:exported="false"/>
<activity android:name=".MenuBuilderActivity" android:exported="false"/>
<service android:name=".WorkerService" android:exported="false" android:foregroundServiceType="dataSync"/>
</application>
</manifest>

+    private void showInstalledApps() {
+        PackageManager pm=getPackageManager();
+        Intent q=new Intent(Intent.ACTION_MAIN);q.addCategory(Intent.CATEGORY_LAUNCHER);
+        List<ResolveInfo> resolved=pm.queryIntentActivities(q,0);
+        final ArrayList<ResolveInfo> all=new ArrayList<>();
+        HashSet<String> seen=new HashSet<>();
+        for(ResolveInfo r:resolved){
+            if(r==null||r.activityInfo==null||r.activityInfo.applicationInfo==null)continue;
+            String pkg=r.activityInfo.packageName;
+            if(pkg==null||pkg.equals(getPackageName())||!seen.add(pkg))continue;
+            all.add(r);
+        }
+        Collections.sort(all,(a,b)->{
+            ApplicationInfo aa=a.activityInfo.applicationInfo,bb=b.activityInfo.applicationInfo;
+            boolean ga=Build.VERSION.SDK_INT>=26&&aa.category==ApplicationInfo.CATEGORY_GAME;
+            boolean gb=Build.VERSION.SDK_INT>=26&&bb.category==ApplicationInfo.CATEGORY_GAME;
+            if(ga!=gb)return ga?-1:1;
+            return String.valueOf(a.loadLabel(pm)).compareToIgnoreCase(String.valueOf(b.loadLabel(pm)));
+        });
+        LinearLayout box=new LinearLayout(this);box.setOrientation(LinearLayout.VERTICAL);box.setPadding(dp(16),dp(8),dp(16),0);
+        EditText filter=new EditText(this);filter.setHint("Поиск по названию или package");filter.setSingleLine(true);box.addView(filter);
+        ListView listView=new ListView(this);box.addView(listView,new LinearLayout.LayoutParams(-1,dp(460)));
+        final ArrayList<ResolveInfo> visible=new ArrayList<>();
+        final ArrayList<String> rows=new ArrayList<>();
+        final ArrayAdapter<String> adapter=new ArrayAdapter<>(this,android.R.layout.simple_list_item_1,rows);listView.setAdapter(adapter);
+        Runnable rebuild=()->{
+            String needle=filter.getText().toString().trim().toLowerCase(Locale.ROOT);visible.clear();rows.clear();
+            for(ResolveInfo r:all){String label=String.valueOf(r.loadLabel(pm));String pkg=r.activityInfo.packageName;
+                if(!needle.isEmpty()&&!label.toLowerCase(Locale.ROOT).contains(needle)&&!pkg.toLowerCase(Locale.ROOT).contains(needle))continue;
+                visible.add(r);boolean isGame=Build.VERSION.SDK_INT>=26&&r.activityInfo.applicationInfo.category==ApplicationInfo.CATEGORY_GAME;
+                rows.add((isGame?"🎮 ":"")+label+"\n"+pkg);
+            }adapter.notifyDataSetChanged();
+        };
+        filter.addTextChangedListener(new TextWatcher(){public void beforeTextChanged(CharSequence s,int a,int c,
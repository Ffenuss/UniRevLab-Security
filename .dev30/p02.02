+            "dexCount": 0,
+            "nativeCount": 0,
+            "metadataEntries": [],
+            "il2cppEntries": [],
+            "unityMarkers": 0,
+            "contentMarkers": 0,
+        }
+        try:
+            with zipfile.ZipFile(path) as z:
+                for info in z.infolist():
+                    name = info.filename
+           
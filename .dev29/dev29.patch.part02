 tmp_path / 'libmk.so'
+    runtime.write_bytes(fixtures.runtime_so_blob())
+    spec = MenuSpec('Packed', controls=[MenuControl(
+        'debug', 'Debug', 'toggle', rva=0x1040, binding='bool_setter',
+        target_so='libil2cpp.so', default=None,
+    )])
+    pack = tmp_path / 'payload.zip'
+    result = write_patch_payload(spec, apk, runtime, pack)
+    assert result['inspection']['blocked'] is False
+    with zipfile.ZipFile(pack) as z:
+        manifest = json.loads(z.read('modkit-payload.json'))
+    assert manifest['autoload'][0]['strategy'] == 'safe-system-chain'
+    assert manifest['preflight']['strategy'] == 'needed-chain'
+    assert manifest['preflight']['displacedDependency'] == 'liblog.so'

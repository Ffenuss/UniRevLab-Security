diff --git a/android/app/src/main/cpp/modkit_runtime.cpp b/android/app/src/main/cpp/modkit_runtime.cpp
index f70b1e6..ea7680e 100644
--- a/android/app/src/main/cpp/modkit_runtime.cpp
+++ b/android/app/src/main/cpp/modkit_runtime.cpp
@@ -28,6 +28,7 @@ constexpr uint32_t K_ACTION = 1;
 constexpr uint32_t K_BOOL = 2;
 constexpr uint32_t K_INT = 3;
 constexpr uint32_t K_FLOAT = 4;
+constexpr uint32_t F_DEFAULT_KNOWN = 1u << 1;
 constexpr uint32_t F_ABI_IL2CPP = 1u << 8;
 constexpr uint32_t F_INSTANCE = 1u << 9;
 constexpr uint32_t F_RESOLVER_RETURN_PTR = 1u << 10;
@@ -535,11 +536,11 @@ void reset_controls() {
     if (!g_cfg) return;
     for (uint32_t i = 0; i < g_cfg->count; ++i) {
         const ConfigEntry &e = g_entries[i];
-        if (e.kind == K_ACTION) continue;
+        if (e.kind == K_ACTION || (e.flags & F_DEFAULT_KNOWN) == 0) continue;
         g_state[i].value = e.default_value;
         apply_control(i);
     }
-    MKLOGI("menu reset: restored defaults for non-action controls");
+    MKLOGI("menu reset: restored known defaults only");
 }
 

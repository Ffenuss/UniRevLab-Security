 MODKIT_BANNER = f"modkit {__version__}"
diff --git a/modkit/menu/builder.py b/modkit/menu/builder.py
index 38d76da..34ddb01 100644
--- a/modkit/menu/builder.py
+++ b/modkit/menu/builder.py
@@ -889,8 +889,21 @@ def write_patch_payload(spec: MenuSpec, source_apk: str | Path, runtime_so: str
         if host_path not in z.namelist():
             raise ValueError(f"source APK does not contain {host_path}")
         # Preflight the exact ELF mutation before writing a payload artifact.
-        host = ElfFile(z.read(host_path))
-        edit_preview = host.add_needed(dependency)
+        # Prefer an additive DT_NEEDED edit, but tightly packed production ELFs
+        # often have no .dynstr/.dynamic slack.  In that case use the same
+        # fail-closed system-dependency chain strategy as Patch Pack itself.
+        host_blob = z.read(host_path)
+        host = ElfFile(host_blob)
+        try:
+            edit_preview = host.add_needed(dependency)
+            autoload_strategy = "add-only"
+        except Exception as add_exc:
+            host = ElfFile(host_blob)
+            edit_preview = host.replace_needed_chain(
+                dependency, runtime_needed=tuple(runtime_elf.needed())
+            )
+            edit_preview["addNeededFailure"] = str(add_exc)
+            autoload_strategy = "safe-system-chain"
         if dependency not in ElfFile(host.blob).needed():
             raise ValueError("DT_NEEDED preflight did not persist")
 
@@ -915,7 +928,7 @@ def write_patch_payload(spec: MenuSpec, source_apk: str | Path, runtime_so: str
         "renderHostDetection": render_detection,

+
+
+def test_dev29_runtime_config_marks_only_explicit_defaults_as_resettable():
+    from modkit.menu import MenuControl, MenuSpec
+    from modkit.menu.runtime_config import encode_runtime_config, decode_runtime_config, F_DEFAULT_KNOWN
+    spec = MenuSpec("Reset provenance", controls=[
+        MenuControl("unknown", "Unknown original", "toggle", rva=0x1040, binding="bool_setter",
+                    target_so="libil2cpp.so", default=None),
+        MenuControl("known", "Known original", "toggle", rva=0x1050, binding="bool_setter",
+                    target_so="libil2cpp.so", default=False),
+        MenuControl("speed", "Neutral speed", "slider_float", rva=0x1060, binding="number_setter",
+                    target_so="libil2cpp.so", min_value=0.25, max_value=3.0, default=1.0,
+                    value_type="System.Single"),
+    ])
+    cfg = decode_runtime_config(encode_runtime_config(spec))
+    rows = {row["id"]: row for row in cfg["controls"]}
+    assert (rows["unknown"]["flags"] & F_DEFAULT_KNOWN) == 0
+    assert rows["known"]["flags"] & F_DEFAULT_KNOWN
+    assert rows["speed"]["flags"] & F_DEFAULT_KNOWN
+
+
+def test_dev29_patch_payload_falls_back_to_safe_needed_chain_when_dynstr_is_packed(tmp_path):
+    import json
+    import zipfile
+    from modkit.menu import MenuControl, MenuSpec, write_patch_payload
+    from modkit.elf.reader import ElfFile
+    from modkit.selftest import fixtures
+
+    host_blob = bytearray(fixtures.so_blob())
+    host = ElfFile(bytes(host_blob))
+    dynstr = host.section('.dynstr')
+    raw = host_blob[dynstr.offset:dynstr.offset + dynstr.size]
+    trailing = len(raw) - len(raw.rstrip(b'\0'))
+    assert trailing > 1
+    # Simulate a production ELF whose .dynstr has no room for a new soname.
+    slack_start = dynstr.offset + dynstr.size - trailing
+    host_blob[slack_start:dynstr.offset + dynstr.size - 1] = b'X' * (trailing - 1)
+    packed = ElfFile(bytes(host_blob))
+    with __import__('pytest').raises(ValueError, match='trailing zero bytes'):
+        packed.add_needed('libmk.so')
+
+    apk = tmp_path / 'packed.apk'
+    with zipfile.ZipFile(apk, 'w') as z:
+        z.writestr('lib/arm64-v8a/libil2cpp.so', bytes(host_blob))

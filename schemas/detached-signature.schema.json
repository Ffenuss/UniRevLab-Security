{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirevlab.org/schemas/detached-signature-1.0.json",
  "title": "UniRevLab Detached Ed25519 Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "payloadSha256", "publicKeySha256", "signatureBase64"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "algorithm": {"const": "ED25519"},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicKeySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signatureBase64": {"type": "string", "minLength": 40, "maxLength": 512}
  }
}

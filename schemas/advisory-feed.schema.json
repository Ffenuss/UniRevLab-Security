{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirevlab.org/schemas/advisory-feed-1.0.json",
  "title": "UniRevLab Normalized Advisory Feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feedId", "source", "generatedAt", "advisories"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "feedId": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {"type": "string", "minLength": 1, "maxLength": 512},
    "generatedAt": {"type": "string", "minLength": 1, "maxLength": 128},
    "advisories": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "componentId", "affectedVersions", "severity", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "aliases": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 160}},
          "componentId": {"type": "string", "minLength": 1, "maxLength": 512},
          "affectedVersions": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]},
          "summary": {"type": "string", "maxLength": 1000},
          "source": {"type": "string", "maxLength": 512}
        }
      }
    }
  }
}

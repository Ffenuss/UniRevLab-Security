+    private JSONObject read(){try{return new JSONObject(Io.readUtf8(app.file("simple-catalog.json")));}catch(Exception e){return null;}}
+    private void refresh(){if(revision==app.revision)return;revision=app.revision;status.setText(app.status==null?"":app.status);JSONObject o=read();if(o==null){summary.setText("Список ещё не создан. Выберите установленное приложение и нажмите шаг 2.");adapter.set(new JSONArray());build.setEnabled(false);return;}JSONArray cards=o.optJSONArray("cards");JSONObject counts=o.optJSONObject("counts");summary.setText("Найдено: "+o.optInt("total")+" · READY: "+o.optInt("buildable")+" · server/trust audit: "+o.optInt("serverAudit")+"\n"+(counts==null?"":counts.toString()));adapter.set(cards==null?new JSONArray():cards);build.setEnabled(!app.busy.get()&&!selected.isEmpty());prepare.setEnabled(!app.busy.get());}
+    private void showDetails(JSONObject c){String title=c.optString("title");StringBuilder m=new StringBuilder();m.append(c.optString("description")).append("\n\nСтатус: ").append(c.optString("status")).append("\nИсточник: ").append(c.optString("source")).append("\nКатегория: ").append(c.optString("category"));if(c.optBoolean("serverAudit"))m.append("\n\nСерверная/аккаунтная граница: ModKit показывает доказательства и теоретическую модель риска, но не генерирует обход серверной проверки, платежей или экономики. Использовать такие сценарии можно только в явно разрешённой тестовой среде.");JSONObject e=c.optJSONObject("evidence");if(e!=null)m.append("\n\nEvidence:\n").append(e.toString());new AlertDialog.Builder(this).setTitle(title).setMessage(m.toString()).setPositiveButton(android.R.string.ok,null).show();}

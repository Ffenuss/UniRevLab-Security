Resources().getDisplayMetrics().density);}
+    private TextView text(String s,int size){TextView t=new TextView(this);t.setText(s);t.setTextSize(size);t.setTextColor(Color.rgb(225,230,235));t.setPadding(0,dp(5),0,dp(5));return t;}
+    private Button button(String s,LinearLayout p,View.OnClickListener l){Button b=new Button(this);b.setText(s);b.setAllCaps(false);b.setOnClickListener(l);p.addView(b);return b;}
+    @Override public void onCreate(Bundle state){super.onCreate(state);app=(App)getApplication();LinearLayout root=new LinearLayout(this);root.setOrientation(LinearLayout.VERTICAL);root.setPadding(dp(14),dp(14),dp(14),dp(14));root.setBackgroundColor(Color.rgb(16,20,24));
+        TextView title=text("Для глупых · авто-режим",28);title.setTypeface(null,Typeface.BOLD);root.addView(title);root.addView(text("Выберите установленное приложение/игру. ModKit сам определит Android/Unity/IL2CPP/Cocos/Lua/native, выполнит полный доступный анализ и покажет все смысловые находки. Только подтверждённые локальные bindings можно собрать автоматически.",13));
+        button("1 · Выбрать установленное приложение / игру",root,v->startActivity(new Intent(this,MainActivity.class).putExtra("autoInstalledPicker",true)));
+        prepare=button("2 · Обновить полный анализ и список находок",root,v->startWork(new Intent().putExtra("op","simple_prepare")));
+        summary=text("",13);root.addView(summary);status=text("",13);root.addView(status);

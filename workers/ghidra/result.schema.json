{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirevlab.org/schemas/ghidra-worker-result-1.3.json",
  "title": "UniRevLab Ghidra Worker Result 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentId",
    "artifactSha256",
    "libraryEntry",
    "status",
    "engine",
    "architecture",
    "coverage",
    "functions",
    "cfg",
    "xrefs",
    "jniRegistrations",
    "il2cppRegistrations",
    "il2cppCodegenCalls",
    "il2cppPointerTables",
    "il2cppCodegenModules",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "libraryEntry": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "pyGhidra",
        "analysisProfile"
      ],
      "properties": {
        "name": {
          "const": "Ghidra"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "pyGhidra": {
          "type": "boolean"
        },
        "analysisProfile": {
          "enum": [
            "DEFAULT",
            "DEEP"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionsDiscovered",
        "functionsReported",
        "cfgBlocksReported",
        "xrefsReported",
        "decompilerFunctionsReported",
        "truncated"
      ],
      "properties": {
        "functionsDiscovered": {
          "type": "integer",
          "minimum": 0
        },
        "functionsReported": {
          "type": "integer",
          "minimum": 0
        },
        "cfgBlocksReported": {
          "type": "integer",
          "minimum": 0
        },
        "xrefsReported": {
          "type": "integer",
          "minimum": 0
        },
        "decompilerFunctionsReported": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rva",
          "name",
          "namespace",
          "signature",
          "sizeBytes",
          "isThunk",
          "decompilerPreview"
        ],
        "properties": {
          "rva": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "isThunk": {
            "type": "boolean"
          },
          "decompilerPreview": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cfg": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "functionRva",
          "blocks",
          "edges"
        ],
        "properties": {
          "functionRva": {
            "type": "integer",
            "minimum": 0
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startRva",
                "endRva",
                "flowType"
              ],
              "properties": {
                "startRva": {
                  "type": "integer",
                  "minimum": 0
                },
                "endRva": {
                  "type": "integer",
                  "minimum": 0
                },
                "flowType": {
                  "type": "string"
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fromRva",
                "toRva",
                "kind"
              ],
              "properties": {
                "fromRva": {
                  "type": "integer",
                  "minimum": 0
                },
                "toRva": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "enum": [
                    "FALL_THROUGH",
                    "CONDITIONAL",
                    "UNCONDITIONAL",
                    "CALL",
                    "COMPUTED",
                    "OTHER"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "xrefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromRva",
          "toRva",
          "kind"
        ],
        "properties": {
          "fromRva": {
            "type": "integer",
            "minimum": 0
          },
          "toRva": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "CALL",
              "JUMP",
              "DATA",
              "READ",
              "WRITE",
              "OTHER"
            ]
          }
        }
      }
    },
    "jniRegistrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "className",
          "methodName",
          "signature",
          "functionRva",
          "confidence",
          "tableRva",
          "registerNativesCallsiteRva",
          "findClassCallsiteRva",
          "classEvidence"
        ],
        "properties": {
          "source": {
            "enum": [
              "STATIC_EXPORT",
              "REGISTER_NATIVES_TABLE"
            ]
          },
          "className": {
            "type": "string"
          },
          "methodName": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "functionRva": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "tableRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "registerNativesCallsiteRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "findClassCallsiteRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "classEvidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      }
    },
    "il2cppRegistrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "rva",
          "symbolName",
          "evidence",
          "confidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CODE_REGISTRATION",
              "METADATA_REGISTRATION",
              "CODEGEN_REGISTER"
            ]
          },
          "rva": {
            "type": "integer",
            "minimum": 0
          },
          "symbolName": {
            "type": "string"
          },
          "evidence": {
            "enum": [
              "DEFINED_SYMBOL",
              "CALLSITE_REFERENCE",
              "STRUCTURAL_CANDIDATE"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processor",
        "pointerSize",
        "endian"
      ],
      "properties": {
        "processor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pointerSize": {
          "enum": [
            4,
            8
          ]
        },
        "endian": {
          "enum": [
            "LITTLE",
            "BIG"
          ]
        }
      }
    },
    "il2cppCodegenCalls": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callsiteRva",
          "codeRegistrationRva",
          "metadataRegistrationRva",
          "codegenOptionsRva",
          "evidence",
          "confidence"
        ],
        "properties": {
          "callsiteRva": {
            "type": "integer",
            "minimum": 0
          },
          "codeRegistrationRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "metadataRegistrationRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "codegenOptionsRva": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidence": {
            "const": "DECOMPILER_PCODE_CALL_ARGUMENTS"
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      }
    },
    "il2cppPointerTables": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ownerRva",
          "fieldOffsetBytes",
          "entryCount",
          "tableRva",
          "sampledEntries",
          "executableEntries",
          "sampleFunctionRvas",
          "confidence"
        ],
        "properties": {
          "ownerRva": {
            "type": "integer",
            "minimum": 0
          },
          "fieldOffsetBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "entryCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000000
          },
          "tableRva": {
            "type": "integer",
            "minimum": 0
          },
          "sampledEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "executableEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "sampleFunctionRvas": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM"
            ]
          }
        }
      }
    },
    "il2cppCodegenModules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ownerCodeRegistrationRva",
          "moduleRva",
          "moduleName",
          "methodPointerCount",
          "methodPointersRva",
          "sampledMethodPointers",
          "evidence",
          "confidence"
        ],
        "properties": {
          "ownerCodeRegistrationRva": {
            "type": "integer",
            "minimum": 0
          },
          "moduleRva": {
            "type": "integer",
            "minimum": 0
          },
          "moduleName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "methodPointerCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000
          },
          "methodPointersRva": {
            "type": "integer",
            "minimum": 0
          },
          "sampledMethodPointers": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slotIndex",
                "functionRva"
              ],
              "properties": {
                "slotIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "functionRva": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "evidence": {
            "type": "string",
            "maxLength": 128
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        }
      }
    }
  }
}
